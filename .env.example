# Copy to .env and fill in. Never commit .env.

# The address people type in the browser. Caddy gets the HTTPS certificate for it.
NI_HOST=inventory.example.ch
NI_ADMIN_PASSWORD=change-me-now

# Directory sign-in and nightly user sync (Active Directory)
# NI_LDAP_URL=ldaps://dc01.example.ch:636
# NI_LDAP_BIND={login}@example.ch
# NI_LDAP_BASE=DC=example,DC=ch
# NI_LDAP_GROUP=Inventory-Users          only members of this group may sign in
# NI_LDAP_ADMIN_GROUP=IT-Inventory       members of this group are admins
# NI_LDAP_SERVICE_DN=CN=svc-inventory,OU=Service,DC=example,DC=ch
# NI_LDAP_SERVICE_PASSWORD=
# NI_LDAP_USER_FILTER=(&(objectClass=user)(!(objectClass=computer)))
# NI_LDAP_CA=/certs/internal-ca.pem     only for a certificate from an internal CA

# Lansweeper API (nightly sync at 06:00). Check the query first: npm run lansweeper:introspect
# NI_LS_TOKEN=
# NI_LS_URL=https://api.lansweeper.com/api/v2/graphql
# NI_LS_AUTH_SCHEME=Token                 or Bearer, depending on the token type
# NI_LS_SITE=                             site id; empty uses the first authorised site

# Lansweeper report file, used when no API token is set (put the file in ./feed)
# NI_FEED_CSV=/feed/report.csv
