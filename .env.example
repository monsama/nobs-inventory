# Non-secret settings. Written by deploy-nobs.sh; edit here, then: docker compose up -d
# Secrets (admin password, LDAP service password, Lansweeper token) live in ./secrets, not here.

NI_HOST=inventory.example.ch
NI_SECURE_COOKIE=1
# Time zone for scheduled syncs and the times the server writes (IANA name, e.g. Europe/Zurich, Europe/Berlin)
TZ=Europe/Zurich
HTTP_PORT=80
HTTPS_PORT=443

# Directory sign-in and nightly user sync (Active Directory)
# NI_LDAP_URL=ldaps://dc01.example.ch:636
# NI_LDAP_BIND={login}@example.ch
# NI_LDAP_BASE=DC=example,DC=ch
# NI_LDAP_GROUP=CN=Inventory-Users,OU=Groups,DC=example,DC=ch   (a DN also counts nested groups)
# NI_LDAP_ADMIN_GROUP=CN=IT-Inventory,OU=Groups,DC=example,DC=ch
# NI_LDAP_SERVICE_DN=CN=svc-inventory,OU=Service,DC=example,DC=ch
# NI_LDAP_USER_FILTER=(&(objectClass=user)(!(objectClass=computer)))
# NI_LDAP_CA=/certs/internal-ca.pem
# A directory address saved in Settings may use 389, 636, 3268 or 3269; other ports only when listed here.
# NI_LDAP_PORTS=10636
# The proxy whose forwarded client address the app believes (the shared Caddy). Empty: no proxy in front.
# NI_TRUSTED_PROXY=nobs-proxy

# Lansweeper API (nightly 06:00). Check the query first: npm run lansweeper:introspect
# NI_LS_URL=https://api.lansweeper.com/api/v2/graphql
# NI_LS_AUTH_SCHEME=Token
# NI_LS_SITE=

# Token for scripts/Lansweeper-Push.ps1 (run on the Lansweeper server). Set it in ./secrets or here.
# NI_FEED_TOKEN=

# Lansweeper report file, used when no API token is set (put the file in ./feed)
# NI_FEED_CSV=/feed/report.csv

# Encrypt the host backups (scripts/backup.sh) with the passphrase in this file. Keep a copy of the file away from
# this server: without it, an encrypted backup cannot be restored.
# BACKUP_PASSPHRASE_FILE=/root/nobs-backup-passphrase

# Optional: a nightly encrypted copy of the backups outside the server. Mount a share (SMB/NFS) on the host, point
# NI_BACKUP_EXPORT_HOST at it, set NI_BACKUP_EXPORT_DIR=/offsite, then turn it on and set its password in
# Settings → Maintenance → Backups. The folder must be writable for the app (user 1000).
# NI_BACKUP_EXPORT_HOST=/mnt/backup-share/nobs
# NI_BACKUP_EXPORT_DIR=/offsite

# Optional: the weekly e-mail to the admins (turned on in Settings → Maintenance). Port 465 is TLS, 587 STARTTLS;
# an internal relay often needs no user. NI_PUBLIC_URL is the address the mail links to.
# NI_SMTP_HOST=smtp.example.com
# NI_SMTP_PORT=587
# NI_SMTP_USER=inventory@example.com
# NI_SMTP_PASSWORD=
# NI_SMTP_FROM=NOBS Inventory <inventory@example.com>
# NI_PUBLIC_URL=https://inventory.example.com/
