# Non-secret settings. Written by deploy-nobs.sh; edit here, then: docker compose up -d
# Secrets (admin password, LDAP service password, Lansweeper token) live in ./secrets, not here.

NI_HOST=inventory.example.ch
NI_SECURE_COOKIE=1
HTTP_PORT=80
HTTPS_PORT=443

# Directory sign-in and nightly user sync (Active Directory)
# NI_LDAP_URL=ldaps://dc01.example.ch:636
# NI_LDAP_BIND={login}@example.ch
# NI_LDAP_BASE=DC=example,DC=ch
# NI_LDAP_GROUP=CN=Inventory-Users,OU=Groups,DC=example,DC=ch   (a DN also counts nested groups)
# NI_LDAP_ADMIN_GROUP=CN=IT-Inventory,OU=Groups,DC=example,DC=ch
# NI_LDAP_SERVICE_DN=CN=svc-inventory,OU=Service,DC=example,DC=ch
# NI_LDAP_USER_FILTER=(&(objectClass=user)(!(objectClass=computer)))
# NI_LDAP_CA=/certs/internal-ca.pem

# Lansweeper API (nightly 06:00). Check the query first: npm run lansweeper:introspect
# NI_LS_URL=https://api.lansweeper.com/api/v2/graphql
# NI_LS_AUTH_SCHEME=Token
# NI_LS_SITE=

# Lansweeper report file, used when no API token is set (put the file in ./feed)
# NI_FEED_CSV=/feed/report.csv
