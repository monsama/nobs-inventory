# NOBS Inventory proxy. Certificates come from ./certificates (not from Let's Encrypt),
# so this works for internal names. Replace them with scripts/install-cert.sh.
{
	auto_https off
	admin off
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /certs/nobs.crt /certs/nobs.key
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Strict-Transport-Security "max-age=31536000"   (enable once the certificate is trusted)
	}
	reverse_proxy nobs-inventory:8080
}
