# Copy to .env and fill in. Never commit .env.
# The address people type in the browser. Caddy gets the HTTPS certificate for it.
NI_HOST=inventory.example.ch
NI_ADMIN_PASSWORD=change-me-now
# LDAP / Active Directory (optional)
# NI_LDAP_URL=ldaps://dc01.monsama.ch:636
# NI_LDAP_BIND={login}@monsama.ch
# NI_LDAP_BASE=OU=Users,DC=monsama,DC=ch
# NI_LDAP_ADMIN_GROUP=IT-Inventory
# Nightly Lansweeper report file, in ./feed
# NI_FEED_CSV=/feed/report.csv
